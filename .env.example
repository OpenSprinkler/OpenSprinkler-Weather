# Network
# Use 127.0.0.1 instead for a local-only service.
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Provider and geocoder. OpenMeteo requires no API key.
WEATHER_PROVIDER=OpenMeteo
GEOCODER=WU
# Set GEOCODER=GoogleMaps to geocode text locations with this key.
GOOGLE_MAPS_API_KEY=

# Provider credentials, required only when the corresponding provider is used.
ACCUWEATHER_API_KEY=
OWM_API_KEY=
PIRATEWEATHER_API_KEY=
APPLE_PRIVATE_KEY=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_SERVICE_ID=

# Local PWS upload and persistence.
PWS=none
PWS_WEATHER_PROVIDER=WU
LOCAL_PERSISTENCE=false
PERSISTENCE_LOCATION=.

# Optional file overrides.
BASELINE_ETO_FILE=baselineEToData/Baseline_ETo_Data.bin
GEOCODER_CACHE_FILE=geocoderCache.json
